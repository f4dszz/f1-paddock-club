# Frontend env vars — baked into the static bundle at build time.
# Every VITE_* value is PUBLIC by design. Never put secrets here.
#
# In local dev, an empty file is fine — Vite proxies /api and /ws to
# the backend at 127.0.0.1:8001 and the bundle falls back to demo-token
# mode when VITE_CLERK_PUBLISHABLE_KEY is unset.

# Backend topology (set in Vercel for production)
VITE_BACKEND_URL=
VITE_WS_URL=

# Clerk publishable key (public). When set, the frontend mounts
# ClerkProvider, gates the app with <SignedIn>/<SignedOut>, and uses
# the Clerk JWT on every backend call.
VITE_CLERK_PUBLISHABLE_KEY=

# Sentry frontend DSN (public — a Sentry DSN is intentionally exposed).
VITE_SENTRY_DSN_FRONTEND=

# Environment label sent to Sentry, helps separate prod/preview events.
VITE_APP_ENV=local

# Optional demo-token fallback. Used only when VITE_CLERK_PUBLISHABLE_KEY
# is unset (dev / E2E lane). Match it to backend DEMO_ACCESS_TOKEN.
VITE_DEMO_TOKEN=
