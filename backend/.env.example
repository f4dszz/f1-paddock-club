# F1 Paddock Club — backend environment variables
# Copy this file to backend/.env and fill in the values you need.
# .env is gitignored; .env.example is not.

# ─── Runtime / environment ───────────────────────────────────────────
# APP_ENV selects the deploy profile. Anything other than "local" enables
# the access gate (token/Clerk auth) and prod-leaning defaults.
#   local (default) | test | staging | production
# APP_ENV=local
# ENV is an accepted ALIAS for APP_ENV (read as a fallback when APP_ENV is
# unset). Set one or the other; APP_ENV wins if both are present.
# ENV=production
#
# LOG_LEVEL controls logging verbosity (default INFO).
#   DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# ─── Provider selector ───────────────────────────────────────────────
# Which LLM provider should the itinerary/tour agents use?
#   openai     (default) — needs OPENAI_API_KEY below
#   anthropic            — needs ANTHROPIC_API_KEY below
LLM_PROVIDER=openai


# ─── OpenAI / OpenAI-compatible ──────────────────────────────────────
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Optional: model name. Defaults to gpt-4o-mini (cheap + good for our use case).
# Other reasonable picks: gpt-4o, gpt-4.1-mini, o4-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional: base URL for OpenAI-compatible providers
# (DeepSeek, Moonshot/Kimi, Zhipu GLM, Alibaba Qwen, local vLLM, etc.)
# Leave unset to use the official OpenAI endpoint.
# OPENAI_BASE_URL=https://api.deepseek.com/v1


# ─── Anthropic (only if LLM_PROVIDER=anthropic) ──────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy/v1


# ─── LLM client tunables (graceful defaults; override only if needed) ─
# Per-request LLM (httpx) timeout in seconds. Default 60, floor 1.
# LLM_REQUEST_TIMEOUT_SECONDS=60
# LLM client max retries on transient errors. Default 2.
# LLM_MAX_RETRIES=2
# Hard wall-clock deadline for the refine supervisor run, in seconds.
# Default 120; set 0 to disable the deadline.
# REFINE_DEADLINE_SECONDS=120
# Per-identity daily LLM call ceiling (abuse/cost control). Default 200;
# set 0 to disable.
# LLM_DAILY_CALL_LIMIT=200
# Deterministic mock-LLM switch for tests / CI / E2E. MUST NOT be set in
# production — it forces stub itinerary/tour/refine output (no real LLM call).
# LLM_STUB_MODE=1


# ─── Data tools ──────────────────────────────────────────────────────
# SerpAPI — flights (google_flights engine) + hotels (google_hotels engine)
# + Google web search. Free 100 searches/month. https://serpapi.com
# SERPAPI_API_KEY=...

# Firecrawl — scrape F1 official ticket pages behind Cloudflare/JS.
# Free 500 pages/month. https://firecrawl.dev
# FIRECRAWL_API_KEY=...

# Tavily — LLM-optimized web search. Free 1000/month. https://tavily.com
# Falls back to DuckDuckGo (free, no key) if not set.
# TAVILY_API_KEY=...


# ─── Deployment security / cost-abuse controls ──────────────────────
# Local dev defaults to no token gate. Any non-local APP_ENV, or setting
# DEMO_ACCESS_TOKEN, enables the backend access gate.
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEMO_ACCESS_TOKEN=change-me
# MAX_CONCURRENT_PLANS=5
# PLAN_ACQUIRE_TIMEOUT_SECONDS=5
# HTTP_RATE_LIMIT_PER_MINUTE=60
# WS_CONNECT_LIMIT_PER_MINUTE=20
#
# Number of trusted reverse-proxy hops for X-Forwarded-For client-IP
# selection. Default 1 (Railway/Vercel edge). Set 0 to treat XFF as
# untrusted (use the socket peer IP).
# TRUSTED_PROXY_HOPS=1
#
# WebSocket limits.
# WS_IDLE_TIMEOUT_SECONDS — close a WS that has been idle this long. Default 300.
# WS_IDLE_TIMEOUT_SECONDS=300
# MAX_WS_CONNECTIONS — global cap on concurrent OPEN WebSocket sessions. Default 100.
# MAX_WS_CONNECTIONS=100
#
# SAVED_TRIPS_PER_USER_MAX — per-user saved-trips cap. Default 100; 0 disables.
# SAVED_TRIPS_PER_USER_MAX=100


# ─── Enterprise floor (Clerk + Postgres + Sentry) ────────────────────
# These are the new variables introduced by the enterprise-floor design.
# Local dev can leave them unset — the backend falls back to SQLite +
# demo-token auth + no Sentry. Production deploys MUST set the secret
# ones marked below.

# Clerk auth — register at https://dashboard.clerk.com
# Backend auth is pure JWKS verification: it needs the ISSUER + JWKS URL.
# In production, REQUIRE_CLERK_AUTH=true is the safer default; APP_ENV=
# production already enforces it.
# CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev        # non-secret
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# REQUIRE_CLERK_AUTH=true
#
# Optional expected JWT 'aud' claim. When SET, the audience is verified and
# the 'aud' claim is REQUIRED; when unset, current behavior is kept so
# local/demo still works. In production with Clerk enforced, a missing
# CLERK_AUDIENCE is a config warning, not a hard crash.
# CLERK_AUDIENCE=your-clerk-audience
#
# svix signing secret for the Clerk user.deleted webhook. When UNSET the
# /webhooks/clerk endpoint is disabled (503). Required to honor account
# deletions in production.
# CLERK_WEBHOOK_SECRET=whsec_...                               # secret

# Postgres — on Railway, the Postgres addon auto-injects DATABASE_URL as a bare
# postgresql:// URL; db.py rewrites it to postgresql+psycopg:// (psycopg3) for you,
# so you do not need to override it. For local dev, leaving this unset uses
# backend/_dev.sqlite3 (gitignored).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db    # secret

# Sentry backend — register at https://sentry.io, create a "f1-paddock-
# backend" project, copy the DSN. Leaving empty disables Sentry.
# SENTRY_DSN_BACKEND=https://...@oXXXXX.ingest.sentry.io/YYYYY   # secret
# SENTRY_TRACES_SAMPLE_RATE=0.1                                  # non-secret
