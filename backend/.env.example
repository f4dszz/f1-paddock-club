# F1 Paddock Club — backend environment variables
# Copy this file to backend/.env and fill in the values you need.
# .env is gitignored; .env.example is not.

# ─── Provider selector ───────────────────────────────────────────────
# Which LLM provider should the itinerary/tour agents use?
#   openai     (default) — needs OPENAI_API_KEY below
#   anthropic            — needs ANTHROPIC_API_KEY below
LLM_PROVIDER=openai


# ─── OpenAI / OpenAI-compatible ──────────────────────────────────────
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Optional: model name. Defaults to gpt-4o-mini (cheap + good for our use case).
# Other reasonable picks: gpt-4o, gpt-4.1-mini, o4-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional: base URL for OpenAI-compatible providers
# (DeepSeek, Moonshot/Kimi, Zhipu GLM, Alibaba Qwen, local vLLM, etc.)
# Leave unset to use the official OpenAI endpoint.
# OPENAI_BASE_URL=https://api.deepseek.com/v1


# ─── Anthropic (only if LLM_PROVIDER=anthropic) ──────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy/v1


# ─── Data tools ──────────────────────────────────────────────────────
# SerpAPI — flights (google_flights engine) + hotels (google_hotels engine)
# + Bing/Baidu search. Free 100 searches/month. https://serpapi.com
# SERPAPI_API_KEY=...

# Firecrawl — scrape F1 official ticket pages behind Cloudflare/JS.
# Free 500 pages/month. https://firecrawl.dev
# FIRECRAWL_API_KEY=...

# Tavily — LLM-optimized web search. Free 1000/month. https://tavily.com
# Falls back to DuckDuckGo (free, no key) if not set.
# TAVILY_API_KEY=...


# ─── Deployment security / cost-abuse controls ──────────────────────
# Local dev defaults to no token gate. Any non-local APP_ENV, or setting
# DEMO_ACCESS_TOKEN, enables the backend access gate.
# APP_ENV=local
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEMO_ACCESS_TOKEN=change-me
# REQUIRE_DEMO_TOKEN=false
# MAX_CONCURRENT_PLANS=5
# PLAN_ACQUIRE_TIMEOUT_SECONDS=5
# HTTP_RATE_LIMIT_PER_MINUTE=60
# WS_CONNECT_LIMIT_PER_MINUTE=20

# ─── China OTA (optional, as fallback for Chinese departure routes) ──
# FLIGGY_APP_KEY=...
# FLIGGY_APP_SECRET=...
# BOCHA_API_KEY=...


# ─── Enterprise floor (Clerk + Postgres + Sentry) ────────────────────
# These are the new variables introduced by the enterprise-floor design.
# Local dev can leave them unset — the backend falls back to SQLite +
# demo-token auth + no Sentry. Production deploys MUST set the secret
# ones marked below.

# Clerk auth — register at https://dashboard.clerk.com
# In production, REQUIRE_CLERK_AUTH=true is the safer default; APP_ENV=
# production already enforces it.
# CLERK_SECRET_KEY=sk_test_...                                # secret
# CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev        # non-secret
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# REQUIRE_CLERK_AUTH=true

# Postgres — on Railway, the Postgres addon auto-injects DATABASE_URL as a bare
# postgresql:// URL; db.py rewrites it to postgresql+psycopg:// (psycopg3) for you,
# so you do not need to override it. For local dev, leaving this unset uses
# backend/_dev.sqlite3 (gitignored).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db    # secret

# Sentry backend — register at https://sentry.io, create a "f1-paddock-
# backend" project, copy the DSN. Leaving empty disables Sentry.
# SENTRY_DSN_BACKEND=https://...@oXXXXX.ingest.sentry.io/YYYYY   # secret
# SENTRY_TRACES_SAMPLE_RATE=0.1                                  # non-secret
